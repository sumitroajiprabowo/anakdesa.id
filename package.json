{
  "name": "anakdesa-id",
  "version": "1.0.0",
  "private": true,
  "description": "Anak Desa Indonesia — Media Digital dari Desa. Showcase landing page.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
